---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PhotoPlaceholder from '../components/site/PhotoPlaceholder.astro';
import BookingCta from '../components/site/BookingCta.astro';
import RelatedLinks from '../components/site/RelatedLinks.astro';
import { createServiceStructuredData } from '../data/site';

const title = 'Drainage lymphatique à Autrans | Fanny Cayol Peridon';
const description =
  'Drainage lymphatique doux ou dynamique à Autrans par Fanny Cayol Peridon : jambes, chevilles, visage, cou, ventre et bas du dos.';
const serviceStructuredData = createServiceStructuredData({
  name: 'Drainage lymphatique à Autrans',
  description,
  path: '/drainage-lymphatique/',
  offers: [
    { name: 'Drainage lymphatique · 60 minutes', price: 70 },
    { name: 'Drainage lymphatique · 90 minutes', price: 100 },
  ],
});
---

<SiteLayout title={title} description={description} canonicalPath="/drainage-lymphatique/" pageType="MedicalWebPage" extraStructuredData={serviceStructuredData}>
  <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Drainage lymphatique' }]} />
  <PageHero
    eyebrow="Deux approches personnalisées"
    title="Drainage lymphatique à Autrans"
    intro="Drainage doux ou dynamique : je choisis avec vous le rythme, la profondeur et les zones travaillées selon vos besoins et la sensation recherchée."
    photoLabel="Soin de drainage lymphatique manuel"
  >
    <div slot="actions" class="actions">
      <a class="button button--primary" href="/cabinet-tarifs-rendez-vous/">Voir les tarifs</a>
    </div>
  </PageHero>

  <section class="section-shell section-space">
    <div class="split-layout">
      <div class="split-layout__copy">
        <p class="eyebrow">Une compétence de masseur-kinésithérapeute</p>
        <h2>Une formation spécialisée</h2>
        <p>
          J’ai développé cette compétence dans le cadre de ma formation en masso-kinésithérapie,
          auprès de Maryvonne Chardon-Bras, spécialiste internationale du drainage lymphatique.
        </p>
        <p>
          Je l’ai également approfondie au contact de services hospitaliers spécialisés en
          lymphologie. Les soins proposés aujourd’hui à NATURASOI ne sont pas des consultations de
          kinésithérapie.
        </p>
      </div>
      <PhotoPlaceholder label="Détail des mains pendant le drainage" format="square" />
    </div>
  </section>

  <section class="section-shell section-space--tight">
    <div class="section-heading">
      <p class="eyebrow">Doux ou dynamique</p>
      <h2>Deux types de drainage lymphatique</h2>
    </div>
    <div class="content-grid">
      <article class="content-card">
        <h3>Drainage lymphatique doux</h3>
        <p>
          Des pressions légères et des mouvements lents et précis accompagnent naturellement la
          circulation de la lymphe. Cette approche est particulièrement appréciée pour contribuer à
          réduire la rétention d’eau et les sensations de gonflement, notamment au niveau des jambes
          et des chevilles, tout en procurant une sensation de légèreté et de bien-être.
        </p>
      </article>
      <article class="content-card">
        <h3>Drainage lymphatique dynamique</h3>
        <p>
          Plus rythmé et plus profond, ce massage circulatoire stimule la circulation lymphatique. Il
          peut contribuer à diminuer l’aspect de la cellulite, à raffermir la peau et à réduire le
          volume des zones travaillées. Il convient aux personnes qui recherchent un travail plus
          tonique sans renoncer au bien-être.
        </p>
      </article>
    </div>
  </section>

  <section class="section-shell section-space--tight">
    <div class="content-grid">
      <article class="content-card">
        <h3>Zones travaillées</h3>
        <p>
          Le drainage peut concerner les jambes, les chevilles, le visage, le cou, le ventre, le bas
          du dos et plus largement différentes zones du corps selon vos besoins. Les jambes et les
          chevilles sont particulièrement mises en avant pour rechercher une sensation de légèreté.
        </p>
      </article>
      <article class="content-card">
        <h3>Des effets recherchés, sans garantie</h3>
        <p>
          Selon la personne et la zone, le drainage peut contribuer à diminuer le gonflement, à
          réduire le volume des zones travaillées — notamment les jambes ou le cou —, à apporter une
          sensation de légèreté ou à améliorer l’aspect de la cellulite. Les effets varient d’une
          personne à l’autre.
        </p>
      </article>
      <article class="content-card">
        <h3>Après un accouchement</h3>
        <p>
          Un drainage peut aussi être proposé après un accouchement lorsque la situation le permet.
          En cas de signes pouvant évoquer une phlébite ou de douleurs anormales, consultez d’abord
          un médecin avant de venir.
        </p>
      </article>
    </div>
  </section>

  <section class="section-shell section-space--tight">
    <div class="info-band">
      <p class="eyebrow">Bons cadeaux</p>
      <h2>Un cadeau de naissance tout en douceur</h2>
      <p class="lead">
        Offrez à une jeune maman un moment de bien-être auprès d’une professionnelle de santé
        qualifiée, attentive et à l’écoute. Les bons cadeaux sont personnalisés selon la durée et le
        soin choisis.
      </p>
      <div class="actions">
        <a class="button button--secondary" href="mailto:fcayolperidon@gmail.com?subject=Je%20souhaite%20offrir%20un%20bon%20cadeau">
          Demander un bon cadeau
        </a>
      </div>
    </div>
  </section>

  <section class="section-shell section-space--tight">
    <div class="info-band">
      <p class="eyebrow">Tarifs</p>
      <h2>Choisir la durée du drainage</h2>
      <div class="price-list">
        <div class="price-row"><span>Drainage lymphatique · 60 min</span><strong>70 €</strong></div>
        <div class="price-row"><span>Drainage lymphatique · 90 min</span><strong>100 €</strong></div>
      </div>
    </div>
  </section>

  <RelatedLinks
    links={[
      { title: 'Massages à Autrans', description: 'Détente, récupération sportive, ayurvédique et massage thérapeutique.', href: '/massages/' },
      { title: 'Découvrir Fanny', description: 'Mon parcours de masseur-kinésithérapeute et d’ostéopathe.', href: '/fanny-cayol-peridon/' },
      { title: 'Tarifs et rendez-vous', description: 'Retrouver les tarifs, l’accès et le contact.', href: '/cabinet-tarifs-rendez-vous/' },
    ]}
  />

  <BookingCta title="Choisissons ensemble la durée adaptée" text="Indiquez-moi par SMS les zones que vous souhaitez travailler. Je pourrai vous orienter vers le format le plus approprié." />
</SiteLayout>
