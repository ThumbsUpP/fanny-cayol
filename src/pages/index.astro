---
import { FannyPage } from '../components';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bienvenue chez Fanny Cayol-Peridon</title>
    <!-- Google Tag Manager -->
    <script>
      type DataLayerItem = Record<string, unknown>;

      interface GTMWindow extends Window {
        dataLayer?: DataLayerItem[];
      }

      (function loadGTM(w: GTMWindow, d: Document, i: string) {
        const dataLayer = (w.dataLayer ??= []);
        dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });

        const firstScript = d.getElementsByTagName('script')[0];
        if (!firstScript || !firstScript.parentNode) {
          return;
        }

        const gtmScript = d.createElement('script');
        gtmScript.async = true;
        gtmScript.src = `https://www.googletagmanager.com/gtm.js?id=${i}`;
        firstScript.parentNode.insertBefore(gtmScript, firstScript);
      })(window as GTMWindow, document, 'GTM-KDXTDQX4');
    </script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P2CBWWEQJ9"></script>
    <script>
      type GtagArgs = [string, ...unknown[]];

      interface GtagWindow extends Window {
        dataLayer?: GtagArgs[];
      }

      const gtagWindow = window as GtagWindow;
      const dataLayer = (gtagWindow.dataLayer ??= []);

      function gtag(...args: GtagArgs) {
        dataLayer.push(args);
      }

      gtag('js', new Date());
      gtag('config', 'G-P2CBWWEQJ9');
    </script>
    <meta
      name="description"
      content="Kinésithérapeute, ostéopathe et masseuse à Autrans-Méaudre. Prenez rendez-vous pour un moment de bien-être sur-mesure."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link rel="preload" as="image" href="/images/hero-bg.jpg" />
    <link rel="preload" as="image" href="/images/profile-picture.jpeg" fetchpriority="high" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KDXTDQX4"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe
    ></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <FannyPage />
  </body>
</html>
